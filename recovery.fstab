# A95X F4 recovery fstab
# Minimal TWRP recovery partition map for the SC2 device.
# Logical Android partitions are exposed through the dynamic super partition.

/boot emmc /dev/block/by-name/boot flags=display="Boot";backup=1;flashimg=1
/dtbo emmc /dev/block/by-name/dtbo flags=display="DTBO";backup=1;flashimg=1
/vendor_boot emmc /dev/block/by-name/vendor_boot flags=display="Vendor Boot";backup=1;flashimg=1
/super emmc /dev/block/by-name/super flags=display="Super";backup=1;flashimg=1
/misc emmc /dev/block/by-name/misc flags=display="Misc";backup=1
/metadata ext4 /dev/block/by-name/metadata flags=display="Metadata";backup=1
/data ext4 /dev/block/by-name/userdata flags=display="Data";backup=1;length=-16384
/storage ext4 /data/media/0 flags=display="Internal Storage";storage;removable=0;bind
/cache ext4 /dev/block/by-name/cache flags=display="Cache";backup=1;wipeingui
